# Format documentation: http://kicad-pcb.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
*.sch-bak
*~
*.lck
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
*fp-info-cache
*-cache.lib

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# PCB output files
/output/
/bom/

# Backup files
/*-backups/

# Cubemx config files
/stm32cubemx/*
!stm32cubemx/*/*.ioc

# Python files
.ipynb_checkpoints/

# MAC
**/.DS_Store

#LTspice simulation result
*.raw

#kicad history
.history/


#STM32CubeMX

/stm32cubemx/*
!/stm32cubemx/*.ioc
